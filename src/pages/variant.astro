---
import Base from '../layouts/Base.astro';
import VariantHero from '../components/variant/VariantHero.astro';
import VariantComparison from '../components/variant/VariantComparison.astro';
import VariantShowcase from '../components/variant/VariantShowcase.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Extra Cover — Mod Cricket 26 in 1 Click"
  description="Mod Cricket 26 in 1 Click. Visual assets, stadium textures, broadcast HUD overlays. Create your own packs using Pack Studio. Free for Windows & Steam."
>
  <main class="page">
    <VariantHero />
    <VariantComparison />
    <VariantShowcase />
    <HowItWorks />
    <Faq />
  </main>

  <Footer />
</Base>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
</style>
