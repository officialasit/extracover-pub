---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import { guideStructuredData, indexingEnabled, installGuide, siteUrls } from '../../lib/seo';
import '../../styles/minimal.css';
import '../../styles/guide.css';
const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}images/${name}`;
const discordInviteUrl = 'https://discord.gg/zfvrW5uDj9';
const urls = siteUrls(Astro.site);
const jsonLd = JSON.stringify(guideStructuredData(urls)).replace(/</g, '\\u003c');

// Real app captures live in public/images/guide/. A slot renders only once its
// file exists, so the guide never shows a placeholder or a mocked-up screen.
type Shot = { file: string; alt: string; caption: string; width: number; height: number };
const shot = (file: string, alt: string, caption: string, width = 1601, height = 961): Shot | null =>
  existsSync(resolve('public/images', file)) ? { file, alt, caption, width, height } : null;
const shots = {
  locate: shot('guide/setup-locate.webp', 'Extra Cover setup screen confirming the Cricket 26 install folder', 'Setup finds Cricket 26 in your Steam library and checks the install.'),
  index: shot('guide/setup-index.webp', 'Extra Cover setup screen showing the completed mod index', 'Indexing reads the game files. Nothing is written to the game.'),
  community: shot('guide/community-pack.webp', 'Community pack details in Extra Cover with a Download button and a View on GameBanana link', 'A community pack from GameBanana. Download adds it to your library; it does not change the game yet.'),
  import: shot('guide/import-pack.webp', 'Extra Cover settings panel with the Import a pack option', 'Settings → Pack library → Import a pack.'),
  library: shot('guide/library.webp', 'Extra Cover pack library with stadium packs, two marked as installed', 'Your library groups packs by type. A tick marks packs that are installed in the game.'),
  install: shot('guide/install-pack.webp', 'Pack details in Extra Cover showing the description, creator credits and an Install button', 'Pack details show the creator, size, version and where the pack came from. Close Cricket 26, then choose Install.'),
  disable: shot('guide/disable-pack.webp', 'An installed pack in Extra Cover marked Installed in Cricket 26, with a Disable mod button', 'Installed packs show “Installed in Cricket 26”. Disable mod restores the original files and keeps the pack in your library.'),
};

const formats = [
  ['.c26pack', 'An Extra Cover pack: a ZIP archive with a manifest.json and the replacement files it lists. Import it, drag it onto the window, or double-click it.'],
  ['.zip', 'Some sites serve a .c26pack as a .zip. Import a pack accepts it; drag and drop expects .c26pack.'],
  ['Inside a pack', 'Packs carry game-ready textures (DDS) and Wwise audio (.wem / .bnk). You never open these yourself.'],
];
const unsupported = [
  'Loose texture or audio files copied into the game folder',
  'Archives without a manifest.json, or with executable files',
  'Game Pass, cracked or console copies of Cricket 26',
];

const troubleshooting = [
  ['“Cricket 26 is running — close the game before installing mods”', 'Quit to desktop, wait a few seconds, and check Task Manager for a leftover Cricket26.exe. Extra Cover refuses to change files while the game is open.'],
  ['“Automatic detection came up empty” or “This folder is not a moddable Cricket 26 install.”', 'Choose the folder manually. It is the folder containing Cricket26.exe and a data subfolder — in Steam, right-click Cricket 26 → Manage → Browse local files. Only the Steam PC build is supported.'],
  ['“Cricket 26 was updated since setup — re-run setup from Settings before applying mods”', 'Open Settings → Troubleshooting → Re-index game, then install the pack again. If the pack was made before the update, check whether its creator has released a new version.'],
  ['“This pack changes stadium art, which needs a refreshed game index.”', 'Choose Re-index now on the message (or Re-index game in Settings), then install it again.'],
  ['“No manifest.json found — this does not look like an Extra Cover pack.”', 'The file is not a .c26pack. Loose files and mods made for other tools cannot be imported. Ask the creator for a .c26pack.'],
  ['“A pack with the id … is already installed.”', 'You already have a version of this pack. Confirm the replacement when asked. If the old version is installed in the game, choose Disable mod first.'],
  ['“Not enough free disk space to import this pack”', 'Free up the amount shown on the drive Extra Cover uses, then import again.'],
  ['“Extra Cover is already changing your game or pack library — wait for that to finish.”', 'Another install, removal or download is still running. Let it finish before starting the next one.'],
  ['The game looks wrong or you want to start fresh', 'Use Settings → Troubleshooting → Disable all mods. As a last resort, Verify game files with Steam restores every original file; Extra Cover notices the change when you return to it.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={installGuide.description} />
    <meta name="robots" content={indexingEnabled ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta name="theme-color" content="#0e1116" />
    <link rel="canonical" href={urls.installGuide} />
    {indexingEnabled && <link rel="sitemap" type="application/xml" href={urls.sitemap} />}
    <meta property="og:title" content={installGuide.title} />
    <meta property="og:description" content={installGuide.description} />
    <meta property="og:url" content={urls.installGuide} />
    <meta property="og:site_name" content="Extra Cover" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={installGuide.published} />
    <meta property="article:modified_time" content={installGuide.modified} />
    <meta property="og:image" content={urls.socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Extra Cover — modding software for Cricket 26" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={installGuide.title} />
    <meta name="twitter:description" content={installGuide.description} />
    <meta name="twitter:image" content={urls.socialImage} />
    <meta name="twitter:image:alt" content="Extra Cover — modding software for Cricket 26" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <title>{installGuide.title}</title>
    <link rel="icon" href={`${base}images/brand-icon.png`} type="image/png" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="preload" as="font" href={`${base}fonts/manrope-latin-800-normal.woff2`} type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem('ec-landing-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <noscript><style is:inline>
      .mobile-menu,.theme-toggle{display:none!important}
      @media(max-width:767px){#main-nav{display:flex;position:static;padding:0;border:0;flex-wrap:wrap;gap:4px 16px;margin:0}#main-nav a{min-height:36px}.site-header{height:auto;position:static}.nav-inner{flex-wrap:wrap;padding-block:12px}.nav-actions{display:none}}
    </style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-inner">
        <a href={base} class="brand-link" aria-label="Extra Cover home"><Brand /></a>
        <nav aria-label="Main navigation" id="main-nav">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}#how-it-works`}>How it works</a>
          <a href={`${base}#pack-studio`}>For creators</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-button theme-toggle" aria-label="Switch colour theme"><Icon name="sun-moon" /></button>
          <a class="button button-small" href={`${base}#download`}>Get Beta Updates <Icon name="arrow-down" size={16}/></a>
          <button class="icon-button mobile-menu" aria-label="Open navigation" aria-controls="main-nav" aria-expanded="false"><Icon name="menu-2" /></button>
        </div>
      </div>
    </header>

    <main id="main" class="guide container">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb">
        <a href={base}>Extra Cover</a><span aria-hidden="true">/</span><span aria-current="page">Install guide</span>
      </nav>

      <header class="guide-header">
        <p class="eyebrow">GUIDE · WINDOWS · STEAM</p>
        <h1>{installGuide.headline}</h1>
        <p class="guide-lede">Install Cricket 26 mods on a Windows PC with Extra Cover, a free community mod manager. Set it up once, add a pack, then install it with one click. You can undo any mod.</p>
        <p class="guide-meta">Published <time datetime={installGuide.published}>8 October 2026</time> · About 6 minutes</p>
      </header>

      <aside class="guide-callout" aria-label="Release status">
        <Icon name="bell" size={22} />
        <div>
          <p><strong>Extra Cover is in pre-release.</strong> The public installer is not available yet. This guide describes the current beta. Join the Discord for release news and setup help.</p>
          <a class="button button-small" href={discordInviteUrl} target="_blank" rel="noopener noreferrer">Get Beta Updates <Icon name="arrow-up-right" size={16}/></a>
        </div>
      </aside>

      <nav class="guide-toc" aria-labelledby="toc-title">
        <h2 id="toc-title">On this page</h2>
        <ol>
          <li><a href="#requirements">What you need</a></li>
          <li><a href="#formats">Supported mod formats</a></li>
          <li><a href="#setup">Step 1: Set up Extra Cover</a></li>
          <li><a href="#get-pack">Step 2: Add a pack</a></li>
          <li><a href="#install">Step 3: Install and play</a></li>
          <li><a href="#undo">Undo or remove a mod</a></li>
          <li><a href="#updates">After a Cricket 26 update</a></li>
          <li><a href="#troubleshooting">Troubleshooting</a></li>
        </ol>
      </nav>

      <article class="guide-body">
        <section id="requirements" aria-labelledby="requirements-title">
          <h2 id="requirements-title">What you need</h2>
          <ul class="guide-checklist">
            <li><Icon name="check" size={18}/><span><strong>A Windows PC.</strong> Extra Cover is a Windows app.</span></li>
            <li><Icon name="check" size={18}/><span><strong>Cricket 26 installed through Steam.</strong> Game Pass, cracked and console copies are not supported.</span></li>
            <li><Icon name="check" size={18}/><span><strong>Some free disk space.</strong> Extra Cover backs up every original file a pack replaces.</span></li>
            <li><Icon name="check" size={18}/><span><strong>Cricket 26 closed</strong> whenever you install or disable a mod.</span></li>
          </ul>
          <p>Extra Cover is free to use. It is an independent community tool, not affiliated with or endorsed by Big Ant Studios or Nacon.</p>
        </section>

        <section id="formats" aria-labelledby="formats-title">
          <h2 id="formats-title">Supported mod formats</h2>
          <p>Extra Cover installs <strong>packs</strong>. A pack lists exactly which game files it replaces, so Extra Cover can install it safely and put the originals back later.</p>
          <div class="guide-table" role="region" aria-label="Supported formats" tabindex="0">
            <table>
              <thead><tr><th scope="col">Format</th><th scope="col">What it is</th></tr></thead>
              <tbody>{formats.map(([name, detail]) => <tr><th scope="row">{name.startsWith(".") ? <code>{name}</code> : name}</th><td>{detail}</td></tr>)}</tbody>
            </table>
          </div>
          <h3>Not supported</h3>
          <ul class="guide-list">{unsupported.map(item => <li>{item}</li>)}</ul>
          <p>Packs can change supported stadium textures, commentary, menus, logos, kits, music and crowd audio. Each pack changes only the files its creator listed. It does not add new stadiums or change gameplay.</p>
        </section>

        <section id="setup" aria-labelledby="setup-title">
          <h2 id="setup-title"><span class="guide-step">1</span>Set up Extra Cover</h2>
          <p>Setup runs once, the first time you open Extra Cover.</p>
          <ol class="guide-steps">
            <li><strong>Locate your game.</strong> Extra Cover searches your Steam libraries for Cricket 26. It checks that the folder contains <code>data-0.blobset.pc</code> and that it can write there.</li>
            <li><strong>If it isn’t found,</strong> choose <em>Browse for game folder</em>. Pick the folder containing <code>Cricket26.exe</code> and a <code>data</code> subfolder. In Steam, right-click Cricket 26 → <em>Manage</em> → <em>Browse local files</em> to open it.</li>
            <li><strong>Build the mod index.</strong> Extra Cover reads the game’s archives so it knows where each moddable file lives. Nothing is written to the game while it indexes.</li>
            <li><strong>Open the dashboard</strong> when you see “You’re ready to mod”.</li>
          </ol>
          <div class="guide-paths">
            <p>Typical install folders:</p>
            <code>C:\Program Files (x86)\Steam\steamapps\common\Cricket 26</code>
            <code>D:\SteamLibrary\steamapps\common\Cricket 26</code>
          </div>
          {shots.locate && <figure class="guide-shot"><img src={img(shots.locate.file)} alt={shots.locate.alt} width={shots.locate.width} height={shots.locate.height} loading="lazy" decoding="async" /><figcaption>{shots.locate.caption}</figcaption></figure>}
          {shots.index && <figure class="guide-shot"><img src={img(shots.index.file)} alt={shots.index.alt} width={shots.index.width} height={shots.index.height} loading="lazy" decoding="async" /><figcaption>{shots.index.caption}</figcaption></figure>}
        </section>

        <section id="get-pack" aria-labelledby="get-pack-title">
          <h2 id="get-pack-title"><span class="guide-step">2</span>Add a pack</h2>
          <p>There are two ways to add a pack to your library. Adding a pack never changes the game — that happens only when you choose Install.</p>
          <h3>Browse community packs</h3>
          <p>Open the <em>Browse community</em> tab. It lists packs that creators have published on GameBanana in the <em>Extra Cover Mods</em> category. Choose a pack to see its description, then select <em>Download</em> to add it to your library. <em>View on GameBanana</em> opens its public page. Listings depend on what creators have published.</p>
          {shots.community && <figure class="guide-shot"><img src={img(shots.community.file)} alt={shots.community.alt} width={shots.community.width} height={shots.community.height} loading="lazy" decoding="async" /><figcaption>{shots.community.caption}</figcaption></figure>}
          <h3>Import a .c26pack file</h3>
          <p>If a creator shared a pack with you directly, use any of these:</p>
          <ul class="guide-list">
            <li>Double-click the <code>.c26pack</code> file.</li>
            <li>Drag the file onto the Extra Cover window.</li>
            <li>Open Settings → <em>Pack library</em> → <em>Import a pack</em>, then choose the file.</li>
          </ul>
          <p>Extra Cover checks every pack before adding it. Only install packs from creators you trust, and respect their credits and permissions.</p>
          {shots.import && <figure class="guide-shot"><img src={img(shots.import.file)} alt={shots.import.alt} width={shots.import.width} height={shots.import.height} loading="lazy" decoding="async" /><figcaption>{shots.import.caption}</figcaption></figure>}
        </section>

        <section id="install" aria-labelledby="install-title">
          <h2 id="install-title"><span class="guide-step">3</span>Install and play</h2>
          <ol class="guide-steps">
            <li><strong>Close Cricket 26.</strong> Extra Cover will not change files while the game is running.</li>
            <li><strong>Choose the pack</strong> in your library. Its details show the creator, size, version and where it came from. Select <em>Install</em>.</li>
            <li><strong>Read the first-install note.</strong> The first time, Extra Cover explains that originals are backed up automatically and that <em>Disable mod</em> puts everything back.</li>
            <li><strong>Launch the game</strong> with <em>Launch Cricket 26</em> in Extra Cover, or from Steam as usual.</li>
          </ol>
          <p>When it finishes, the pack shows <em>Installed in Cricket 26</em> and gets a tick in your library. You can install several packs at once and remove any one of them later without affecting the others.</p>
          {shots.install && <figure class="guide-shot"><img src={img(shots.install.file)} alt={shots.install.alt} width={shots.install.width} height={shots.install.height} loading="lazy" decoding="async" /><figcaption>{shots.install.caption}</figcaption></figure>}
          {shots.library && <figure class="guide-shot"><img src={img(shots.library.file)} alt={shots.library.alt} width={shots.library.width} height={shots.library.height} loading="lazy" decoding="async" /><figcaption>{shots.library.caption}</figcaption></figure>}
        </section>

        <section id="undo" aria-labelledby="undo-title">
          <h2 id="undo-title">Undo or remove a mod</h2>
          <ul class="guide-list">
            <li><strong>Disable mod</strong> restores every file that pack changed and keeps the pack in your library, so you can install it again later.</li>
            <li><strong>Disable all mods</strong> (Settings → Troubleshooting) returns the game to its original files.</li>
            <li><strong>Delete from library</strong> removes a pack completely. Disable it first if it is installed in the game.</li>
          </ul>
          <p>Keep Cricket 26 closed while disabling. Steam’s <em>Verify integrity of game files</em> also undoes every mod, at any time.</p>
          {shots.disable && <figure class="guide-shot"><img src={img(shots.disable.file)} alt={shots.disable.alt} width={shots.disable.width} height={shots.disable.height} loading="lazy" decoding="async" /><figcaption>{shots.disable.caption}</figcaption></figure>}
        </section>

        <section id="updates" aria-labelledby="updates-title">
          <h2 id="updates-title">After a Cricket 26 update</h2>
          <p>Game updates can replace modded files and change where assets live. When Extra Cover detects an update, it asks you to refresh its index before installing anything:</p>
          <ol class="guide-steps">
            <li>Open Settings → <em>Troubleshooting</em> → <em>Re-index game</em>.</li>
            <li>Check whether the pack’s creator has released an updated version.</li>
            <li>Install the pack again.</li>
          </ol>
        </section>

        <section id="troubleshooting" aria-labelledby="troubleshooting-title">
          <h2 id="troubleshooting-title">Troubleshooting</h2>
          <p>These are the messages Extra Cover shows, and what to do about each one.</p>
          <div class="guide-faq">
            {troubleshooting.map(([problem, fix]) => <details><summary>{problem}<Icon name="plus" size={18}/></summary><p>{fix}</p></details>)}
          </div>
          <p>Still stuck? Ask in the <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer">Extra Cover Discord</a>. Include the message you saw and what you were installing.</p>
        </section>

        <section class="guide-next" aria-labelledby="next-title">
          <h2 id="next-title">Want to make your own pack?</h2>
          <p>Pack Studio is Extra Cover’s free, optional creator companion. Export supported textures as PNGs, edit them in your own image editor, and build a <code>.c26pack</code>. A full Pack Studio guide is coming soon.</p>
          <a class="text-link" href={`${base}#pack-studio`}>Explore Pack Studio <Icon name="arrow-up-right" size={18}/></a>
        </section>
      </article>
    </main>

    <footer class="site-footer container">
      <div class="footer-top"><a href={base} class="brand-link" aria-label="Back to Extra Cover home"><Brand large /></a><nav aria-label="Footer navigation"><a href={`${base}#faq`}>FAQ</a><a href={`${base}#pack-studio`}>Pack Studio</a><a href={discordInviteUrl} target="_blank" rel="noopener noreferrer">Join Discord</a></nav></div>
      <div class="footer-bottom"><p>An independent community tool for Cricket 26.</p><p>Made for the love of the game.</p></div>
    </footer>
    <script src="../../scripts/interactions.ts"></script>
  </body>
</html>
