---
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import DownloadDialogs from '../../components/DownloadDialogs.astro';
import { releases } from '../../data/releases';
import { guideStructuredData, indexingEnabled, installGuide, siteUrls } from '../../lib/seo';
import '../../styles/minimal.css';
import '../../styles/guide.css';
const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}images/${name}`;
const discordInviteUrl = 'https://discord.gg/zfvrW5uDj9';
const urls = siteUrls(Astro.site);

// Visible answers and FAQ structured data share this list.
const troubleshooting = [
  ['Why does Windows say “Windows protected your PC”?', 'The open beta isn’t code-signed yet, so SmartScreen warns the first time. Choose More info, then Run anyway. Only download Extra Cover from this site or its GitHub releases.'],
  ['Why does Extra Cover say “Cricket 26 is running”?', 'Mods can only be installed or removed while the game is closed. Quit Cricket 26 fully (check Task Manager for Cricket26.exe), then try again.'],
  ['What should I do after a Cricket 26 update?', 'If Extra Cover says “Cricket 26 was updated since setup”, open Settings → Troubleshooting → Re-index game, then install the pack again. Check whether the creator has an updated version.'],
  ['Why won’t my mod file import?', 'Extra Cover installs .c26pack files. If it says “This does not look like an Extra Cover pack”, the file is loose files or a mod made for another tool, which can’t be imported.'],
  ['How do I remove all Cricket 26 mods?', 'Open Settings → Troubleshooting → Disable all mods. Steam’s Verify integrity of game files also restores every original file.'],
];
const jsonLd = JSON.stringify(guideStructuredData(urls, troubleshooting)).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={installGuide.description} />
    <meta name="robots" content={indexingEnabled ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta name="theme-color" content="#0e1116" />
    <link rel="canonical" href={urls.installGuide} />
    {indexingEnabled && <link rel="sitemap" type="application/xml" href={urls.sitemap} />}
    <meta property="og:title" content={installGuide.title} />
    <meta property="og:description" content={installGuide.description} />
    <meta property="og:url" content={urls.installGuide} />
    <meta property="og:site_name" content="Extra Cover" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={installGuide.published} />
    <meta property="article:modified_time" content={installGuide.modified} />
    <meta property="og:image" content={urls.socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Extra Cover — modding software for Cricket 26" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={installGuide.title} />
    <meta name="twitter:description" content={installGuide.description} />
    <meta name="twitter:image" content={urls.socialImage} />
    <meta name="twitter:image:alt" content="Extra Cover — modding software for Cricket 26" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <title>{installGuide.title}</title>
    <link rel="icon" href={`${base}images/brand-icon.png`} type="image/png" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="preload" as="font" href={`${base}fonts/manrope-latin-800-normal.woff2`} type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem('ec-landing-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <noscript><style is:inline>
      .mobile-menu,.theme-toggle{display:none!important}
      @media(max-width:767px){#main-nav{display:flex;position:static;padding:0;border:0;flex-wrap:wrap;gap:4px 16px;margin:0}#main-nav a{min-height:36px}.site-header{height:auto;position:static}.nav-inner{flex-wrap:wrap;padding-block:12px}.nav-actions{display:none}}
    </style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-inner">
        <a href={base} class="brand-link" aria-label="Extra Cover home"><Brand /></a>
        <nav aria-label="Main navigation" id="main-nav">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}#how-it-works`}>How it works</a>
          <a href={`${base}#pack-studio`}>For creators</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-button theme-toggle" aria-label="Switch colour theme"><Icon name="sun-moon" /></button>
          <a class="button button-small" href={`${base}#download`}>Download <Icon name="arrow-down" size={16}/></a>
          <button class="icon-button mobile-menu" aria-label="Open navigation" aria-controls="main-nav" aria-expanded="false"><Icon name="menu-2" /></button>
        </div>
      </div>
    </header>

    <main id="main" class="guide container">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb">
        <a href={base}>Extra Cover</a><span aria-hidden="true">/</span><span aria-current="page">Install guide</span>
      </nav>

      <header class="guide-header">
        <p class="eyebrow">GUIDE · WINDOWS · STEAM</p>
        <h1>{installGuide.headline}</h1>
        <p class="guide-lede"><strong>To install Cricket 26 mods on PC, download Extra Cover, add a pack from Browse community or a .c26pack file, close the game and choose Install.</strong> Extra Cover is a free Cricket 26 modding tool for the Steam version on Windows 10/11, and you can undo any mod.</p>
        <p class="guide-meta">Published <time datetime={installGuide.published}>8 October 2026</time> · 2 minute read</p>
      </header>

      <article class="guide-body">
        <section id="download" aria-labelledby="download-title">
          <h2 id="download-title"><span class="guide-step">1</span>Download Extra Cover</h2>
          <p>Run <code>{releases.extraCover.file}</code> ({releases.extraCover.size}). It isn’t code-signed yet, so Windows SmartScreen warns the first time: choose <em>More info</em>, then <em>Run anyway</em>. The app then finds Cricket 26 and sets itself up.</p>
          <div class="guide-actions">
            <a class="button" href={releases.extraCover.url} data-download-dialog="download-dialog"><Icon name="download" size={17}/> Download v{releases.extraCover.version}</a>
            <a class="text-link" href={releases.extraCover.notes} target="_blank" rel="noopener noreferrer">Release notes <Icon name="arrow-up-right" size={16}/></a>
          </div>
        </section>

        <section id="get-pack" aria-labelledby="get-pack-title">
          <h2 id="get-pack-title"><span class="guide-step">2</span>Get a pack</h2>
          <p>Open <em>Browse community</em> and choose <em>Download</em> on any pack, or double-click a <code>.c26pack</code> file someone shared with you. Adding a pack doesn’t change the game yet.</p>
          <figure class="guide-shot"><img src={img('guide/community-pack.webp')} alt="Community pack details in Extra Cover with a Download button and a View on GameBanana link" width="1601" height="961" loading="lazy" decoding="async" /></figure>
        </section>

        <section id="install" aria-labelledby="install-title">
          <h2 id="install-title"><span class="guide-step">3</span>Install and play</h2>
          <p>Close Cricket 26, open the pack and choose <em>Install</em>. Launch the game and the change is there.</p>
          <figure class="guide-shot"><img src={img('guide/install-pack.webp')} alt="Pack details in Extra Cover showing the description, creator credits and an Install button" width="1601" height="961" loading="lazy" decoding="async" /></figure>
        </section>

        <section id="undo" aria-labelledby="undo-title">
          <h2 id="undo-title">Undo a mod</h2>
          <p>Choose <em>Disable mod</em>. Extra Cover restores the original files and keeps the pack in your library.</p>
          <figure class="guide-shot"><img src={img('guide/disable-pack.webp')} alt="An installed pack in Extra Cover marked Installed in Cricket 26, with a Disable mod button" width="1601" height="961" loading="lazy" decoding="async" /></figure>
        </section>

        <section id="troubleshooting" aria-labelledby="troubleshooting-title">
          <h2 id="troubleshooting-title">Troubleshooting Cricket 26 mods</h2>
          <div class="guide-faq">
            {troubleshooting.map(([problem, fix]) => <details><summary>{problem}<Icon name="plus" size={18}/></summary><p>{fix}</p></details>)}
          </div>
          <p>Still stuck? Ask in the <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer">Extra Cover Discord</a>.</p>
        </section>

        <section class="guide-next" aria-labelledby="next-title">
          <h2 id="next-title">Make your own pack</h2>
          <p>Pack Studio turns your edited textures into a <code>.c26pack</code>. Extract the whole ZIP, then run <code>packstudio.exe</code>.</p>
          <div class="guide-actions">
            <a class="button button-outline" href={releases.packStudio.url} data-download-dialog="studio-download-dialog"><Icon name="download" size={17}/> Download Pack Studio</a>
          </div>
        </section>
      </article>
    </main>

    <footer class="site-footer container">
      <div class="footer-top"><a href={base} class="brand-link" aria-label="Back to Extra Cover home"><Brand large /></a><nav aria-label="Footer navigation"><a href={`${base}#faq`}>FAQ</a><a href={`${base}#pack-studio`}>Pack Studio</a><a href={discordInviteUrl} target="_blank" rel="noopener noreferrer">Join Discord</a></nav></div>
      <div class="footer-bottom"><p>An independent community tool for Cricket 26.</p><p>Made for the love of the game.</p></div>
    </footer>
    <DownloadDialogs discordInviteUrl={discordInviteUrl} />
    <script src="../../scripts/interactions.ts"></script>
  </body>
</html>
