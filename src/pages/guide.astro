---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { links } from '../site.config';

const base = import.meta.env.BASE_URL;

const steps = [
  {
    name: 'Download the installer',
    text: `Grab the latest release from GitHub. It's an unsigned installer — Extra
           Cover is a free fan project, and code-signing certificates cost a few
           hundred dollars a year the project doesn't have.`,
  },
  {
    name: '"Windows protected your PC"? That’s expected.',
    text: `SmartScreen flags any unsigned installer, not just this one. Click
           More info, then Run anyway. If you'd rather verify first, every
           release publishes a SHA-512 checksum for the installer alongside it.`,
  },
  {
    name: 'Let it find your game',
    text: `On first launch, Extra Cover scans the Windows Registry and your Steam
           library folders for Cricket 26 automatically. If it can't find it —
           a non-default install location, usually — you can point it at the
           folder yourself.`,
  },
  {
    name: 'Import or pick a pack',
    text: `Bring in a .c26pack from someone else, or build your own with the
           built-in Pack Studio. Every pack is checked for a valid manifest
           before it's added to your library.`,
  },
  {
    name: 'Apply it',
    text: `One click. Extra Cover backs up every original file it's about to
           touch before changing anything, so removal is a clean revert, not a
           guess. Several packs can be applied at once as long as they don't
           claim the same assets.`,
  },
  {
    name: 'Launch Cricket 26',
    text: `That's it — the mod is live. Remove one pack any time from the same
           screen you installed it from, and the others stay exactly as they
           were.`,
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to install mods for Cricket 26 with Extra Cover',
  description:
    'Step-by-step guide to installing, applying, and removing Cricket 26 mods using Extra Cover.',
  step: steps.map((s) => ({
    '@type': 'HowToStep',
    name: s.name,
    text: s.text.replace(/\s+/g, ' ').trim(),
  })),
};
---

<Base
  title="Installation Guide — Extra Cover"
  description="How to install Cricket 26 mods with Extra Cover: download, get past SmartScreen, auto-detect your Steam install, and apply a pack in one click."
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <Nav sections={false} />

  <main class="page">
    <section class="section intro">
      <div class="section-label">Get started</div>
      <h1 class="section-title">Installing Cricket 26 mods,<br />step by step</h1>
      <p class="section-desc lead">
        No Blobset Tools, no manual file editing. Six steps, most of them one click.
      </p>
      <a class="back" href={base}>&larr; Back to Extra Cover</a>
    </section>

    <section class="section steps-section" aria-label="Installation steps">
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="step reveal" style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h2 class="step-name">{step.name}</h2>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="more">
        Something not covered here? <a href={links.issues}>Ask on GitHub</a> —
        or see the <a href={`${base}#faq`}>FAQ</a> for safety, ban-risk, and
        game-patch questions.
      </p>
    </section>
  </main>

  <Footer sections={false} />
</Base>

<style>
  .page {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Clears the fixed 64px nav; the landing page gets the same clearance from
     the hero's own top padding. */
  .intro {
    padding-top: 132px;
    padding-bottom: 0;
  }
  .lead { margin-bottom: 20px; max-width: 56ch; }

  .back {
    display: inline-block;
    font-size: 13.5px;
    color: var(--text-3);
    transition: color 0.2s ease;
  }
  .back:hover { color: var(--text); text-decoration: none; }

  .steps-section { padding-top: 48px; }

  .steps {
    margin: 0;
    max-width: 760px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .step {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .step:hover {
    border-color: var(--border-hover);
    background: var(--surface-2);
  }

  .idx {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--accent);
    padding-top: 3px;
  }

  .step-name {
    margin: 0 0 6px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .step-text {
    margin: 0;
    max-width: 68ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .more {
    margin: 32px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .more a { color: var(--text-2); border-bottom: 1px solid var(--border-hover); }
  .more a:hover { color: var(--text); }

  @media (max-width: 640px) {
    .intro { padding-top: 112px; }
    .step { gap: 14px; padding: 18px 18px; }
  }
</style>
