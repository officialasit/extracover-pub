---
// Fonts are self-hosted rather than pulled from Google. The design linked the
// CDN; @fontsource ships the same faces as local woff2, which removes a
// third-party request from the critical path and keeps the page working
// wherever fonts.googleapis.com doesn't.
//
// Only the weights the design actually uses:
//   Exo 2       — italic 800 (section heads)
//   Saira       — 400/500/600/700 (body)
//   Azeret Mono — 400/500/700 (labels, figures, the scoreboard strip)
import '@fontsource/exo-2/latin-800-italic.css';
import '@fontsource/saira/latin-400.css';
import '@fontsource/saira/latin-500.css';
import '@fontsource/saira/latin-600.css';
import '@fontsource/saira/latin-700.css';
import '@fontsource/azeret-mono/latin-400.css';
import '@fontsource/azeret-mono/latin-500.css';
import '@fontsource/azeret-mono/latin-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// BASE_URL already carries the /extracover-pub/ prefix and a trailing slash, so
// both of these resolve correctly on GitHub Pages and at the dev-server root.
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-banner.png`, Astro.site);

// SoftwareApplication structured data. Same purpose as the FAQ schema in
// Faq.astro: this is what answer engines (Google AI Overviews, ChatGPT,
// Perplexity) and rich-result cards pull "what is this / what does it cost /
// what platform" from, rather than having to infer it from prose.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Extra Cover',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows',
  description:
    'One-click mod tool for Cricket 26 on Steam/PC. Apply stadium textures, broadcast HUD overlays, and visual asset packs without technical knowledge, and create your own packs with the built-in Pack Studio.',
  url: new URL(base, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: ['https://github.com/officialasit/extracover-pub'],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1c1d22" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />



    {/*
      This card is the advertisement. The site has no organic traffic — it
      spreads by someone pasting the link into a Discord or a forum thread, and
      the preview is all most people will ever see of it. Dimensions are
      declared so clients reserve the right space instead of reflowing, and the
      alt text is there because the card carries the entire pitch as pixels.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Extra Cover" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"
          content="Extra Cover — Mod Cricket 26 in 1 Click. Visual assets, stadium textures, HUD overlays. Free and open source for Windows and Steam." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt"
          content="Extra Cover — Mod Cricket 26 in 1 Click. Free and open source." />

    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>

  <body>
    <slot />
  </body>
</html>

<script>
  // Scroll-triggered reveal for below-the-fold sections marked `.reveal` in
  // markup (see global.css for the fail-open default: fully visible unless this
  // script itself adds `reveal-pending`). Wrapped so a script error or missing
  // IntersectionObserver leaves every section in that default visible state
  // rather than stuck hidden.
  try {
    const targets = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && targets.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target;
            if (entry.isIntersecting) {
              el.classList.remove('reveal-pending');
              el.classList.add(el.dataset.revealSeen ? 'is-visible' : 'is-skipped');
              observer.unobserve(el);
            }
          }
        },
        { threshold: 0.15 }
      );
      targets.forEach((el) => {
        // First callback fires immediately with the element's current state —
        // if it's already on screen at load, mark it seen-but-skip-animation
        // by NOT adding reveal-pending, so it never becomes hidden at all.
        const rect = el.getBoundingClientRect();
        const alreadyVisible = rect.top < window.innerHeight && rect.bottom > 0;
        if (!alreadyVisible) {
          el.dataset.revealSeen = 'true';
          el.classList.add('reveal-pending');
        }
        observer.observe(el);
      });
    }
  } catch {
    // Fail open — do nothing, .reveal's default CSS state is already visible.
  }
</script>
