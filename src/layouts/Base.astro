---
// Fonts are self-hosted rather than pulled from Google. The design linked the
// CDN; @fontsource ships the same faces as local woff2, which removes a
// third-party request from the critical path and keeps the page working
// wherever fonts.googleapis.com doesn't.
//
// Only the weights the design actually uses:
//   Exo 2  — italic 800 (headings) and italic 900 (feature numerals)
//   Saira  — 400/500/600/700
import '@fontsource/exo-2/latin-800-italic.css';
import '@fontsource/exo-2/latin-900-italic.css';
import '@fontsource/saira/latin-400.css';
import '@fontsource/saira/latin-500.css';
import '@fontsource/saira/latin-600.css';
import '@fontsource/saira/latin-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// BASE_URL already carries the /extracover-pub/ prefix and a trailing slash, so
// both of these resolve correctly on GitHub Pages and at the dev-server root.
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-banner.png`, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d0d0f" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <slot />
  </body>
</html>
