---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { links, showDownloadCta } from '../site.config';

interface Props {
  /** Section links only exist on the landing page; the guide passes `false`. */
  sections?: boolean;
}
const { sections = true } = Astro.props;

const base = import.meta.env.BASE_URL;

// On the landing page the section links are same-page anchors; from the guide
// they have to travel back to the index first.
const home = sections ? '#top' : base;
const to = (hash: string) => (sections ? hash : `${base}${hash}`);
---

<nav class="nav" id="nav">
  <div class="nav-left">
    <a href={home} class="logo" aria-label="Extra Cover — home">
      {/* The design drew a generic "EC" tile plus a wordmark. The project has a
          real lockup that already is both, so it goes in that slot at the same
          height. `screen` drops its pure-black ground on this background. */}
      <Image src={logo} alt="Extra Cover" widths={[240, 360]} sizes="132px" loading="eager" class="logo-img" />
    </a>
    <div class="nav-links">
      <a href={to('#features')}>Features</a>
      <a href={to('#how')}>How it works</a>
      <a href={to('#studio')}>Pack Studio</a>
      <a href={to('#faq')}>FAQ</a>
      <a href={`${base}guide/`}>Guide</a>
    </div>
  </div>
  <div class="nav-right">
    <a href={links.source} target="_blank" rel="noopener" class="btn btn-ghost"
       aria-label="View project on GitHub (opens in new tab)">GitHub</a>
    {showDownloadCta
      ? <a href={links.releases} class="btn btn-primary">Download</a>
      : <a href={to('#cta')} class="btn btn-primary">Get Early Access</a>}
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--pad-x);
    background: rgba(9, 9, 11, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .nav.scrolled {
    border-color: var(--border);
    background: rgba(9, 9, 11, 0.92);
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
    min-width: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    transition: opacity 0.2s ease;
  }
  .logo:hover { opacity: 0.85; }
  .logo-img {
    width: 132px;
    height: auto;
    mix-blend-mode: screen;
  }

  .nav-links { display: flex; gap: 24px; }
  .nav-links a {
    font-size: 14px;
    color: var(--text-3);
    transition: color 0.2s ease;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .nav-links a:hover::after { transform: scaleX(1); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
  }

  /* Under ~420px the GitHub button and the CTA cannot both sit next to the
     lockup without one of them wrapping. The CTA is the one that has to
     survive; GitHub is repeated in the footer. */
  @media (max-width: 420px) {
    .nav { padding: 0 16px; }
    .nav-right .btn-ghost { display: none; }
  }
</style>

<script>
  // Hairline + slightly heavier scrim once the page has moved, so the bar
  // separates from the hero without drawing a line over it at rest.
  const nav = document.getElementById('nav');
  if (nav) {
    const sync = () => nav.classList.toggle('scrolled', window.scrollY > 20);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
