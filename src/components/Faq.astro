---
import { links } from '../site.config';

// Six questions, ordered by what a first-time visitor needs before deciding to
// hand over an email or run an unsigned installer. Two answers do real work:
//   * Ban risk — we can describe what the app does, not what the publisher
//     permits, so it says exactly that and stops.
//   * SmartScreen — naming it before someone hits it is the difference between
//     "this looks like malware" and "right, they warned me". It is the single
//     highest-friction moment in the funnel.
const faqs = [
  {
    q: 'Is this safe? Can it break my game?',
    a: `Every file Extra Cover touches is backed up first. Removing a pack restores the
        originals instantly. If anything ever looks wrong, Steam's “Verify integrity of game
        files” will put everything back in a couple of minutes. Community packs are
        structure-checked, but treat them like any other download.`,
  },
  {
    q: 'Can I get banned for using it?',
    a: `Extra Cover only changes files on your own computer. It never touches your Steam
        account or anything online. That said, we can't speak for the publisher's rules — if
        you play online, remove your packs first.`,
  },
  {
    q: 'Which version of Cricket 26 does it support?',
    a: `Cricket 26 on Windows via Steam. Consoles can't load modified files, and other PC
        storefronts aren't supported yet.`,
  },
  {
    q: 'Windows says “Windows protected your PC”',
    a: `That's SmartScreen. It shows up for any free project that hasn't paid for a
        code-signing certificate. Click <strong>More info → Run anyway</strong>. Every release
        also includes a SHA-512 checksum so you can verify the file yourself if you prefer.`,
  },
  {
    q: 'What happens when the game updates?',
    a: `A game patch can overwrite modded files. Extra Cover remembers exactly what it
        changed, notices when the files no longer match, and lets you re-apply your packs
        with one click.`,
  },
  {
    q: 'How do I remove a mod?',
    a: `One click, from the same screen you installed it. Other packs stay untouched. Just
        remove them before uninstalling Extra Cover itself — the uninstaller only removes the
        app, not the changes it made to your game.`,
  },
];

// FAQPage structured data, built from the same array the page renders so the
// two cannot drift. These answers are most of the page's substance, and rich
// results are the only realistic organic play a single landing page has.
// Google requires the marked-up text to match the visible text, hence stripping
// the inline tags and collapsing the template-literal indentation rather than
// hand-maintaining a second copy.
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: plain(f.q),
    acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section" id="faq">
  <div class="section-label">FAQ</div>
  <h2 class="section-title">Questions, answered</h2>
  <p class="section-desc">The things people usually ask before they try a mod tool.</p>

  <div class="faq-list">
    {/*
      The design drove this accordion from JS click handlers on <button>. Native
      <details> gives the same interaction with keyboard support, in-page find,
      and a working no-JS state for free; `name` makes the group exclusive —
      opening one closes the rest — which is what the script was there for.
    */}
    {faqs.map((item, i) => (
      <details class="faq-item reveal" name="faq" style={`--reveal-delay:${i * 60}ms`}>
        <summary class="faq-q">
          <h3>{item.q}</h3>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="faq-a" set:html={item.a} />
      </details>
    ))}
  </div>

  <p class="more">
    Still stuck? <a href={links.issues}>Ask on GitHub</a> — questions are welcome, not just bugs.
  </p>
</section>

<style>
  .faq-list {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .faq-item:hover:not([open]) { border-color: var(--border-hover); }
  .faq-item[open] {
    border-color: var(--accent-edge);
    background: #16161b;
  }

  .faq-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 17px 18px;
    cursor: pointer;
    list-style: none;                      /* Firefox */
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }   /* Safari */

  .faq-q h3 {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--text);
    transition: color 0.2s ease;
    text-wrap: pretty;
  }
  .faq-q:hover h3 { color: #fff; }

  .faq-icon {
    width: 18px;
    height: 18px;
    color: var(--text-3);
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s ease;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .faq-a {
    padding: 0 18px 18px;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .faq-a :global(strong) { color: var(--text); font-weight: 600; }

  /* Height animation on open, where the browser supports interpolating to
     auto. Everywhere else the panel simply snaps open, which is the normal
     <details> behaviour and loses nothing. */
  @supports (interpolate-size: allow-keywords) and selector(::details-content) {
    .faq-item { interpolate-size: allow-keywords; }
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                  content-visibility 0.4s allow-discrete;
      content-visibility: hidden;
    }
    .faq-item[open]::details-content {
      block-size: auto;
      content-visibility: visible;
    }
  }

  .more {
    margin-top: 30px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .more a { color: var(--text-2); border-bottom: 1px solid var(--border-hover); }
  .more a:hover { color: var(--text); }
</style>
