---
const packStudioTools = [
  { title: '1-Click Exporter', detail: 'Compress textures and assets into .c26pack files.' },
  { title: 'Manifest Editor', detail: 'Attach author info, version, and description tags.' },
  { title: 'Integrity Validator', detail: 'Test pack structure before sharing.' },
];

const packAnatomy = [
  { label: 'manifest.json', desc: 'Author, version, description' },
  { label: 'textures/', desc: 'Stadium boards, pitch decals, outfield art' },
  { label: 'overlays/', desc: 'Broadcast HUD, scorebugs, graphics' },
  { label: 'preview.png', desc: 'Thumbnail shown in the pack browser' },
];
---

<section class="v-showcase-section" id="pack-studio">
  <div class="v-showcase-header">
    <div class="eyebrow">Pack Studio</div>
    <h2 class="h-display section-title">Create your own mods</h2>
    <p class="v-showcase-sub">Author, package, and share custom packs with the community.</p>
  </div>

  <div class="v-showcase-grid">
    <div class="v-showcase-column">
      <div class="v-pillar-tag">TOOLS</div>
      <h3 class="v-pillar-title">Authoring Suite</h3>
      <div class="v-cards-stack">
        {packStudioTools.map((p) => (
          <div class="v-pack-card">
            <div class="v-pack-name">{p.title}</div>
            <p class="v-pack-detail">{p.detail}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="v-showcase-column">
      <div class="v-pillar-tag anatomy-tag">PACK ANATOMY</div>
      <h3 class="v-pillar-title">Inside a .c26pack</h3>
      <div class="v-anatomy-list">
        {packAnatomy.map((f) => (
          <div class="v-anatomy-item">
            <code class="v-anatomy-label">{f.label}</code>
            <span class="v-anatomy-desc">{f.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .v-showcase-section {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .v-showcase-header { text-align: center; max-width: 620px; margin: 0 auto 36px; }
  .v-showcase-sub { margin-top: 12px; font-size: 15px; color: var(--ink-2); line-height: 1.55; }

  .v-showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .v-showcase-column {
    background: var(--surface-card);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
  }

  .v-pillar-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--red-bright);
    margin-bottom: 6px;
  }
  .v-pillar-tag.anatomy-tag { color: #4ade80; }

  .v-pillar-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .v-cards-stack { display: flex; flex-direction: column; gap: 12px; }

  .v-pack-card {
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 14px 16px;
  }

  .v-pack-name { font-size: var(--t-sm); font-weight: 700; color: var(--ink); }
  .v-pack-detail { margin: 4px 0 0; font-size: 13px; color: var(--ink-2); line-height: 1.45; }

  .v-anatomy-list { display: flex; flex-direction: column; gap: 10px; }

  .v-anatomy-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 14px 16px;
  }

  .v-anatomy-label {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 600;
    color: #4ade80;
    white-space: nowrap;
    background: rgba(74, 222, 128, 0.08);
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(74, 222, 128, 0.2);
    flex: 0 0 auto;
  }

  .v-anatomy-desc {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.4;
  }

  @media (max-width: 840px) {
    .v-showcase-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
