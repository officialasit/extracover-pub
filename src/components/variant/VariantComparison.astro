---
// Tabler Icons (MIT), self-hosted as literal inline paths — see VariantHero.astro.
const pillars = [
  {
    icon: `<path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11"/>`, // bolt
    title: '1-Click Install & Backup',
    desc: 'Apply or restore mods in seconds with automatic byte-for-byte backups.',
  },
  {
    icon: `<path d="M4 7h3a1 1 0 0 0 1 -1v-1a2 2 0 0 1 4 0v1a1 1 0 0 0 1 1h3a1 1 0 0 1 1 1v3a1 1 0 0 0 1 1h1a2 2 0 0 1 0 4h-1a1 1 0 0 0 -1 1v3a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-1a2 2 0 0 0 -4 0v1a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1h1a2 2 0 0 0 0 -4h-1a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1"/>`, // puzzle
    title: 'Built-in Pack Studio',
    desc: 'Create, package, and share custom mods with the community.',
  },
  {
    icon: `<path d="M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -9"/><path d="M16 3l-4 4l-4 -4"/>`, // device-tv
    title: 'Stadium Boards & HUD',
    desc: 'Customize perimeter LED graphics, outfield decals, and broadcast scorebugs.',
  },
  {
    icon: `<path d="M9 5a3 3 0 0 1 3 -3a3 3 0 0 1 3 3v5a3 3 0 0 1 -3 3a3 3 0 0 1 -3 -3l0 -5"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M8 21l8 0"/><path d="M12 17l0 4"/>`, // microphone
    title: 'Audio & Commentary',
    desc: 'Crowd ambience, chants, and commentary engines in active development.',
    wip: true,
  },
];
---

<section class="v-pillars-section" id="features">
  <div class="v-pillars-header">
    <div class="eyebrow">Features</div>
    <h2 class="h-display section-title">Everything you need</h2>
  </div>

  <div class="v-pillars-grid">
    {pillars.map((item) => (
      <div class={`v-pillar-card ${item.wip ? 'wip' : ''}`}>
        <div class="v-card-head">
          <div class="v-icon-box" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${item.icon}</svg>`} />
          <h3 class="v-pillar-card-title">
            {item.title}
            {item.wip && <span class="v-wip-pill">WIP</span>}
          </h3>
        </div>
        <p class="v-pillar-card-desc">{item.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .v-pillars-section {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .v-pillars-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 36px;
  }

  .v-pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .v-pillar-card {
    background: var(--surface-card);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.2s;
  }
  .v-pillar-card:hover {
    border-color: var(--red-edge);
  }

  .v-pillar-card.wip {
    border-style: dashed;
  }

  .v-card-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .v-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--red-veil);
    border: 1px solid var(--red-edge);
    color: var(--red-bright);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .v-icon-box :global(svg) { width: 20px; height: 20px; }

  .v-pillar-card.wip .v-icon-box {
    background: rgba(250, 176, 5, 0.12);
    border-color: rgba(250, 176, 5, 0.35);
    color: #fcc419;
  }

  .v-pillar-card-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .v-wip-pill {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(250, 176, 5, 0.15);
    color: #fcc419;
    border: 1px solid rgba(250, 176, 5, 0.35);
    letter-spacing: 0.1em;
  }

  .v-pillar-card-desc {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 760px) {
    .v-pillars-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
