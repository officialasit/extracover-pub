---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { subscribeEndpoint, showDownloadCta, links, launchWindow } from '../../site.config';

const base = import.meta.env.BASE_URL;

// Tabler Icons (MIT) for the UI glyphs, Simple Icons (CC0) for the Steam mark
// — self-hosted as literal inline markup, same as everywhere else in this
// codebase avoids a runtime dependency or CDN request for an icon set.
const icon = {
  // tabler: shield-check
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06"/>
             <path d="M15 19l2 2l4 -4"/>
           </svg>`,
  // tabler: click
  cursor: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M3 12l3 0"/><path d="M12 3l0 3"/>
             <path d="M7.8 7.8l-2.2 -2.2"/><path d="M16.2 7.8l2.2 -2.2"/>
             <path d="M7.8 16.2l-2.2 2.2"/>
             <path d="M12 12l9 3l-4 2l-2 4l-3 -9"/>
           </svg>`,
  // tabler: tag
  tag:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M6.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
             <path d="M3 6v5.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l5.592 -5.592a2.41 2.41 0 0 0 0 -3.408l-7.71 -7.71a2 2 0 0 0 -1.414 -.586h-5.172a3 3 0 0 0 -3 3"/>
           </svg>`,
  // simple-icons: steam
  steam:  `<svg viewBox="0 0 24 24" fill="currentColor">
             <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/>
           </svg>`,
};

const terms = [
  { label: 'Originals', value: 'Backed up',       icon: icon.shield },
  { label: 'Install',   value: '1 click',         icon: icon.cursor },
  { label: 'Pack Studio', value: 'Create & Share', icon: icon.tag },
  { label: 'Runs on',   value: 'Windows · Steam', icon: icon.steam },
];
---

<header class="v-header">
  <div class="v-header-inner">
    <a class="v-brand" href="#top" aria-label="Extra Cover — home">
      <Image src={logo} alt="Extra Cover" widths={[280, 420]} sizes="150px" loading="eager" class="v-logo" />
    </a>
    <nav class="v-nav">
      <a class="v-nav-link" href="#features">Features</a>
      <a class="v-nav-link" href="#pack-studio">Pack Studio</a>
      <a class="v-nav-link" href="#how-it-works">How It Works</a>
      <a class="v-nav-link" href="#faq">FAQ</a>
      <a class="v-nav-link" href={`${base}guide/`}>Guide</a>
    </nav>
    <a class="v-cta-btn" href={links.source} target="_blank" rel="noopener" aria-label="View project on GitHub (opens in new tab)">GitHub ↗</a>
  </div>
</header>

<section class="v-hero-section" id="top">
  {/* Dark red crimson ambient hero glow */}
  <div class="v-hero-glow" aria-hidden="true"></div>

  <div class="v-hero-content">
    <div class="v-pill">
      <span class="v-pill-dot" aria-hidden="true"></span>
      {launchWindow ?? 'Launching August'} · Windows & Steam
    </div>

    <h1 class="v-headline">
      Mod Cricket 26 in <span class="gradient-text">1 Click</span>
    </h1>

    <p class="v-sub">
      Manage visual assets, stadium textures, and broadcast HUD overlays for Cricket 26.
      Create and share your own custom packs with the built-in <strong>Pack Studio</strong>.
    </p>

    <div class="v-form-wrapper">
      {showDownloadCta ? (
        <a class="v-btn-primary" href={links.releases}>Download for Windows</a>
      ) : (
        <form
          class="v-signup-form"
          id="signup-variant"
          method="post"
          action={subscribeEndpoint ?? undefined}
          data-endpoint={subscribeEndpoint ?? ''}
        >
          <label class="sr-only" for="email-v">Email address</label>
          <input id="email-v" name="email" type="email" required
                 placeholder="Enter your email for early access" autocomplete="email" />
          <button type="submit" class="v-btn-primary">Get Early Access</button>
        </form>
      )}
      <p class="v-form-note">Free & open source. One notification email on release day.</p>
      <p class="v-msg" id="signup-v-msg" hidden aria-live="polite" role="status"></p>
    </div>

    <!-- Scorecard Metagrid Ticker Bar -->
    <dl class="v-terms reveal">
      {terms.map((t) => (
        <div class="v-term">
          <span class="v-term-icon" aria-hidden="true" set:html={t.icon} />
          <div class="v-term-text">
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .v-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(28, 29, 34, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .v-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1140px;
    margin: 0 auto;
    padding: 16px 24px;
  }
  .v-brand { display: flex; align-items: center; }
  .v-logo { width: 145px; height: auto; mix-blend-mode: screen; }

  .v-nav { display: flex; align-items: center; gap: 28px; }
  .v-nav-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    transition: color 0.15s;
  }
  .v-nav-link:hover { color: var(--ink); text-decoration: none; }

  .v-cta-btn {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--red-bright);
    border: 1px solid var(--red-edge);
    background: var(--red-veil);
    padding: 6px 14px;
    border-radius: 6px;
    transition: background 0.15s, border-color 0.15s;
  }
  .v-cta-btn:hover { background: rgba(240, 62, 62, 0.22); border-color: var(--red-bright); text-decoration: none; }

  .v-hero-section {
    position: relative;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 80px 24px 0;
    text-align: center;
  }

  .v-hero-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 840px;
    height: 520px;
    background: radial-gradient(ellipse 70% 50% at 50% 30%, rgba(240, 62, 62, 0.22) 0%, rgba(201, 42, 42, 0.06) 60%, transparent 85%);
    pointer-events: none;
    z-index: 0;
  }

  .v-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .v-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--red-edge);
    color: var(--red-bright);
    background: var(--red-veil);
    border-radius: 999px;
    padding: 6px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .v-pill-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--red-bright);
    box-shadow: 0 0 8px var(--red-bright);
  }

  .v-headline {
    margin: 28px 0 0;
    max-width: 840px;
    font-family: var(--font-display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .gradient-text {
    background: linear-gradient(135deg, #ff6b6b 0%, #f03e3e 50%, #ff8787 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .v-sub {
    margin: 24px 0 0;
    max-width: 620px;
    font-size: clamp(16px, 2.2vw, 19px);
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .v-sub strong { color: var(--ink); }

  .v-form-wrapper {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
  }

  .v-signup-form {
    display: flex;
    width: 100%;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .v-signup-form input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 10px 16px;
    font-size: 15px;
    font-family: inherit;
    color: var(--ink);
  }
  .v-signup-form input:focus { outline: none; }

  .v-btn-primary {
    flex: 0 0 auto;
    background: var(--red);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 11px 22px;
    font-size: 14.5px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s;
  }
  .v-btn-primary:hover { background: var(--red-deep); color: #fff; text-decoration: none; }

  .v-form-note {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .v-msg {
    margin: 12px 0 0;
    padding: 10px 16px;
    border: 1px solid var(--red-edge);
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--ink);
  }

  .v-terms {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    margin-top: 72px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    text-align: left;
  }
  .v-term {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-left: 1px solid var(--line-2);
  }
  .v-term:first-child { border-left: none; }
  .v-term-icon { width: 20px; height: 20px; color: var(--ink-2); flex: 0 0 auto; }
  .v-term-icon :global(svg) { width: 100%; height: 100%; display: block; }
  .v-term dt { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.12em; }
  .v-term dd { margin: 2px 0 0; font-size: 14px; font-weight: 600; color: var(--ink); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

  @media (max-width: 860px) {
    .v-nav { display: none; }
    .v-terms { grid-template-columns: repeat(2, 1fr); }
    .v-term:nth-child(-n+2) { border-bottom: 1px solid var(--line-2); }
    .v-term:nth-child(odd) { border-left: none; }
  }

  /* Below ~480px, "Pack Studio / Create & Share" and "Runs on / Windows ·
     Steam" wrap to two lines inside a 2-column cell while the other two
     terms stay on one — the row heights mismatch and the wrapped text
     crowds the icon. One column gives every term the full row width. */
  @media (max-width: 480px) {
    .v-terms { grid-template-columns: 1fr; }
    .v-term { border-left: none !important; border-bottom: 1px solid var(--line-2); }
    .v-term:last-child { border-bottom: none; }
  }
</style>

<script>
  // With no PUBLIC_SUBSCRIBE_ENDPOINT configured at build time, the form has
  // no `action` — a real submit POSTs to the current URL, which GitHub Pages
  // can't handle, and the typed email is lost with zero feedback. The markup
  // already carries a hidden #signup-v-msg for exactly this case; this is
  // the wiring that was missing. When an endpoint *is* configured, data-endpoint
  // is non-empty and this listener steps aside so the real POST goes through.
  const form = document.getElementById('signup-variant') as HTMLFormElement | null;
  const msg = document.getElementById('signup-v-msg');
  if (form && msg && !form.dataset.endpoint) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.hidden = false;
      msg.textContent = "Signup isn't open yet — check back after launch.";
    });
  }
</script>
