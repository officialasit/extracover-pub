---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { subscribeEndpoint, showDownloadCta, links, launchWindow } from '../../site.config';

const icon = {
  shield: `<path d="M12 2.6 4.6 5.6v5.9c0 4.4 3.1 8.5 7.4 9.9 4.3-1.4 7.4-5.5 7.4-9.9V5.6L12 2.6Z"/>
           <path d="m8.7 11.9 2.4 2.4 4.2-4.5"/>`,
  cursor: `<path d="M5.6 3.4 17.8 11.1l-5.1.8 2.9 5.4-2.3 1.3-2.9-5.4-3.5 3.8Z"/>`,
  tag:    `<path d="M3.6 11.2V4.3a.7.7 0 0 1 .7-.7h6.9c.2 0 .4.1.5.2l8 8a.7.7 0 0 1 0 1l-6.9 6.9a.7.7 0 0 1-1 0l-8-8a.7.7 0 0 1-.2-.5Z"/>
           <circle cx="7.7" cy="7.7" r="1.3"/>`,
  steam:  `<circle cx="12" cy="12" r="9.6"/>
           <circle cx="15.2" cy="8.8" r="3.9"/>
           <circle cx="15.2" cy="8.8" r="1.45" fill="currentColor" stroke="none"/>
           <circle cx="7.6" cy="15.6" r="2.1"/>
           <path d="M9.2 14.2 12.3 11.4"/>`,
};

const terms = [
  { label: 'Originals', value: 'Backed up',       icon: icon.shield },
  { label: 'Install',   value: '1 click',         icon: icon.cursor },
  { label: 'Pack Studio', value: 'Create & Share', icon: icon.tag },
  { label: 'Runs on',   value: 'Windows · Steam', icon: icon.steam },
];
---

<header class="v-header">
  <div class="v-header-inner">
    <a class="v-brand" href="#top" aria-label="Extra Cover — home">
      <Image src={logo} alt="Extra Cover" widths={[280, 420]} sizes="150px" loading="eager" class="v-logo" />
    </a>
    <nav class="v-nav">
      <a class="v-nav-link" href="#features">Features</a>
      <a class="v-nav-link" href="#pack-studio">Pack Studio</a>
      <a class="v-nav-link" href="#how-it-works">How It Works</a>
      <a class="v-nav-link" href="#faq">FAQ</a>
    </nav>
    <a class="v-cta-btn" href={links.source} target="_blank" rel="noopener" aria-label="View project on GitHub (opens in new tab)">GitHub ↗</a>
  </div>
</header>

<section class="v-hero-section" id="top">
  {/* Dark red crimson ambient hero glow */}
  <div class="v-hero-glow" aria-hidden="true"></div>

  <div class="v-hero-content">
    <div class="v-pill">
      <span class="v-pill-dot" aria-hidden="true"></span>
      {launchWindow ?? 'Launching August'} · Windows & Steam
    </div>

    <h1 class="v-headline">
      Mod Cricket 26 in <span class="gradient-text">1 Click</span>
    </h1>

    <p class="v-sub">
      Manage visual assets, stadium textures, and broadcast HUD overlays for Cricket 26.
      Create and share your own custom packs with the built-in <strong>Pack Studio</strong>.
    </p>

    <div class="v-form-wrapper">
      {showDownloadCta ? (
        <a class="v-btn-primary" href={links.releases}>Download for Windows</a>
      ) : (
        <form
          class="v-signup-form"
          id="signup-variant"
          method="post"
          action={subscribeEndpoint ?? undefined}
          data-endpoint={subscribeEndpoint ?? ''}
        >
          <label class="sr-only" for="email-v">Email address</label>
          <input id="email-v" name="email" type="email" required
                 placeholder="Enter your email for early access" autocomplete="email" />
          <button type="submit" class="v-btn-primary">Get Early Access</button>
        </form>
      )}
      <p class="v-form-note">Free & open source. One notification email on release day.</p>
      <p class="v-msg" id="signup-v-msg" hidden aria-live="polite" role="status"></p>
    </div>

    <!-- Scorecard Metagrid Ticker Bar -->
    <dl class="v-terms">
      {terms.map((t) => (
        <div class="v-term">
          <svg class="v-term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true" set:html={t.icon} />
          <div class="v-term-text">
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .v-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(8, 8, 10, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .v-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1140px;
    margin: 0 auto;
    padding: 16px 24px;
  }
  .v-brand { display: flex; align-items: center; }
  .v-logo { width: 145px; height: auto; mix-blend-mode: screen; }

  .v-nav { display: flex; align-items: center; gap: 28px; }
  .v-nav-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-3);
    transition: color 0.15s;
  }
  .v-nav-link:hover { color: var(--ink); text-decoration: none; }

  .v-cta-btn {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--red-bright);
    border: 1px solid var(--red-edge);
    background: var(--red-veil);
    padding: 6px 14px;
    border-radius: 6px;
    transition: background 0.15s, border-color 0.15s;
  }
  .v-cta-btn:hover { background: rgba(240, 62, 62, 0.22); border-color: var(--red-bright); text-decoration: none; }

  .v-hero-section {
    position: relative;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 80px 24px 0;
    text-align: center;
  }

  .v-hero-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 840px;
    height: 520px;
    background: radial-gradient(ellipse 70% 50% at 50% 30%, rgba(240, 62, 62, 0.22) 0%, rgba(201, 42, 42, 0.06) 60%, transparent 85%);
    pointer-events: none;
    z-index: 0;
  }

  .v-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .v-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--red-edge);
    color: var(--red-bright);
    background: var(--red-veil);
    border-radius: 999px;
    padding: 6px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .v-pill-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--red-bright);
    box-shadow: 0 0 8px var(--red-bright);
  }

  .v-headline {
    margin: 28px 0 0;
    max-width: 840px;
    font-family: var(--font-display);
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .gradient-text {
    background: linear-gradient(135deg, #ff6b6b 0%, #f03e3e 50%, #ff8787 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .v-sub {
    margin: 24px 0 0;
    max-width: 620px;
    font-size: clamp(16px, 2.2vw, 19px);
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .v-sub strong { color: var(--ink); }

  .v-form-wrapper {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
  }

  .v-signup-form {
    display: flex;
    width: 100%;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .v-signup-form input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 10px 16px;
    font-size: 15px;
    font-family: inherit;
    color: var(--ink);
  }
  .v-signup-form input:focus { outline: none; }

  .v-btn-primary {
    flex: 0 0 auto;
    background: var(--red);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 11px 22px;
    font-size: 14.5px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s;
  }
  .v-btn-primary:hover { background: var(--red-deep); color: #fff; text-decoration: none; }

  .v-form-note {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .v-msg {
    margin: 12px 0 0;
    padding: 10px 16px;
    border: 1px solid var(--red-edge);
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--ink);
  }

  .v-terms {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    margin-top: 72px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    text-align: left;
  }
  .v-term {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-left: 1px solid var(--line-2);
  }
  .v-term:first-child { border-left: none; }
  .v-term-icon { width: 20px; height: 20px; color: var(--ink-2); flex: 0 0 auto; }
  .v-term dt { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.12em; }
  .v-term dd { margin: 2px 0 0; font-size: 14px; font-weight: 600; color: var(--ink); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

  @media (max-width: 860px) {
    .v-nav { display: none; }
    .v-terms { grid-template-columns: repeat(2, 1fr); }
    .v-term:nth-child(-n+2) { border-bottom: 1px solid var(--line-2); }
    .v-term:nth-child(odd) { border-left: none; }
  }
</style>
