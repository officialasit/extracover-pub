---
// The four claims the page is asked to prove before anyone will download an
// unsigned installer. Icons inlined (Tabler/Feather-style paths) for the same
// reason as everywhere else — no icon package at runtime.
const items = [
  { label: 'Safe backups',    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
  { label: 'One-click install', icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>' },
  { label: 'Open source',     icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { label: 'Windows + Steam', icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' },
];
---

<div class="trust">
  <div class="trust-inner">
    {items.map((item, i) => (
      <div class="trust-item reveal" style={`--reveal-delay:${i * 60}ms`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
        {item.label}
      </div>
    ))}
  </div>
</div>

<style>
  .trust {
    padding: 28px var(--pad-x);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .trust-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color 0.25s ease, color 0.25s ease, translate 0.2s ease;
  }
  /* `translate` rather than `transform` for the hover lift: `transform` is
     already owned by the scroll-reveal, and the two would overwrite each
     other. Same trick on the feature/step/studio cards. */
  .trust-item:hover {
    border-color: var(--border-hover);
    color: var(--text);
    translate: 0 -1px;
  }
  .trust-item svg {
    width: 14px;
    height: 14px;
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }
  .trust-item:hover svg { transform: scale(1.1); }

  @media (max-width: 600px) {
    .trust { padding: 24px 16px; }
  }
</style>
