---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { subscribeEndpoint, showDownloadCta, links, launchWindow, discordInvite } from '../site.config';

const icon = {
  shield: `<path d="M12 2.6 4.6 5.6v5.9c0 4.4 3.1 8.5 7.4 9.9 4.3-1.4 7.4-5.5 7.4-9.9V5.6L12 2.6Z"/>
           <path d="m8.7 11.9 2.4 2.4 4.2-4.5"/>`,
  cursor: `<path d="M5.6 3.4 17.8 11.1l-5.1.8 2.9 5.4-2.3 1.3-2.9-5.4-3.5 3.8Z"/>`,
  tag:    `<path d="M3.6 11.2V4.3a.7.7 0 0 1 .7-.7h6.9c.2 0 .4.1.5.2l8 8a.7.7 0 0 1 0 1l-6.9 6.9a.7.7 0 0 1-1 0l-8-8a.7.7 0 0 1-.2-.5Z"/>
           <circle cx="7.7" cy="7.7" r="1.3"/>`,
  steam:  `<circle cx="12" cy="12" r="9.6"/>
           <circle cx="15.2" cy="8.8" r="3.9"/>
           <circle cx="15.2" cy="8.8" r="1.45" fill="currentColor" stroke="none"/>
           <circle cx="7.6" cy="15.6" r="2.1"/>
           <path d="M9.2 14.2 12.3 11.4"/>`,
};

const terms = [
  { label: 'Originals', value: 'Backed up',       icon: icon.shield },
  { label: 'Install',   value: '1 click',         icon: icon.cursor },
  { label: 'Price',     value: 'Free',            icon: icon.tag },
  { label: 'Runs on',   value: 'Windows · Steam', icon: icon.steam },
];

const packs = [
  { name: 'IPL Atmosphere',  meta: 'Audio · 42 MB',    cat: 'audio',     active: true },
  { name: 'Wankhede Boards', meta: 'Textures · 18 MB', cat: 'broadcast', active: true },
];
---

<header class="brandbar">
  <a class="brand" href="#top" aria-label="Extra Cover — home">
    <Image src={logo} alt="Extra Cover" widths={[280, 420, 660]}
           sizes="160px" loading="eager" fetchpriority="high" class="brand-img" />
  </a>
  <nav class="brandbar-nav">
    <a class="brandbar-link" href="#features">Features</a>
    <a class="brandbar-link" href="#how-it-works">How It Works</a>
    <a class="brandbar-link" href="#faq">FAQ</a>
    <a class="brandbar-cta" href={links.source} target="_blank" rel="noopener">GitHub ↗</a>
  </nav>
</header>

<section class="hero" id="top">
  <div class="copy">
    <div class="pill">
      <span class="pill-dot" aria-hidden="true"></span>
      {launchWindow ?? 'Launching August'} · Windows & Steam
    </div>

    <h1 class="h-display headline">
      IPL Atmosphere & Stadium Boards for Cricket&nbsp;26
    </h1>

    <p class="sub">
      One-click install for modified crowd noise, stadium chants, and boundary boards. Original game files are backed up automatically.
    </p>

    {showDownloadCta ? (
      <a class="btn-primary download" href={links.releases}>Download for Windows</a>
    ) : (
      <form
        class="signup"
        id="signup"
        method="post"
        action={subscribeEndpoint ?? undefined}
        data-endpoint={subscribeEndpoint ?? ''}
      >
        <label class="sr-only" for="email">Email address</label>
        <input id="email" name="email" type="email" required
               placeholder="Enter your email address" autocomplete="email" />
        <button type="submit" class="btn-primary">Notify me</button>
      </form>
    )}

    <p class="signup-msg" id="signup-msg" role="status" aria-live="polite" hidden></p>

    <p class="ask">
      One notification email on release day. Windows only, no spam ever.
    </p>

    {discordInvite && (
      <p class="secondary">
        Not ready? <a href={discordInvite} rel="noopener">Join the Discord server</a> instead.
      </p>
    )}
  </div>

  <div class="shot" role="img" aria-label="Extra Cover dashboard interface mockup">
    <div class="win">
      <div class="win-bar">
        <span class="win-dot" aria-hidden="true"></span>
        <span class="win-title">Extra Cover</span>
      </div>

      <div class="win-strip">
        <span class="win-mark" aria-hidden="true">✕</span>
        <span class="win-brand">EXTRA COVER</span>
        <span class="win-path">Cricket 26 · Detected</span>
      </div>

      <div class="win-body">
        <div class="win-label">Installed Packs</div>
        <div class="win-grid">
          {packs.map((p) => (
            <div class={`pk ${p.cat}`}>
              <div class="pk-thumb">
                <span class="pk-tick" aria-hidden="true">✓</span>
              </div>
              <div class="pk-meta">
                <div class="pk-name">{p.name}</div>
                <div class="pk-sub">{p.meta}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <dl class="terms">
    {terms.map((t) => (
      <div class="term">
        <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" set:html={t.icon} />
        <div class="term-text">
          <dt>{t.label}</dt>
          <dd>{t.value}</dd>
        </div>
      </div>
    ))}
  </dl>
</section>

<style>
  /* ── Header Bar ── */
  .brandbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 22px var(--pad-x);
  }
  .brand { display: inline-flex; line-height: 0; }
  .brand-img {
    width: 165px;
    height: auto;
    mix-blend-mode: screen;
  }
  .brandbar-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .brandbar-link {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-3);
    transition: color 0.15s;
  }
  .brandbar-link:hover { color: var(--ink); text-decoration: none; }

  .brandbar-cta {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red-bright);
    border: 1px solid var(--red-edge);
    padding: 6px 14px;
    border-radius: 6px;
    background: var(--red-veil);
    transition: background 0.15s, border-color 0.15s;
  }
  .brandbar-cta:hover {
    background: rgba(240, 62, 62, 0.22);
    border-color: var(--red-bright);
    text-decoration: none;
  }

  /* ── Hero Grid ── */
  .hero {
    width: 100%;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 20px var(--pad-x) 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas: 'copy shot' 'terms terms';
    align-items: center;
    column-gap: 48px;
    row-gap: 52px;
  }
  .copy  { grid-area: copy; }
  .shot  { grid-area: shot; }
  .terms { grid-area: terms; }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--red-edge);
    color: var(--red-bright);
    background: var(--red-veil);
    border-radius: 999px;
    padding: 5px 14px 5px 12px;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pill-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--red-bright);
    box-shadow: 0 0 8px var(--red-bright);
  }

  .headline {
    margin: 20px 0 0;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.08;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .sub {
    margin: 18px 0 0;
    max-width: 46ch;
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .signup {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
    max-width: 440px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    padding: 5px;
    border-radius: 10px;
  }
  .signup input {
    flex: 1 1 200px;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 10px 14px;
    font-size: 15px;
    font-family: inherit;
    color: var(--ink);
  }
  .signup input:focus { outline: none; }

  .btn-primary {
    flex: 0 0 auto;
    display: inline-block;
    background: var(--red);
    color: #fff;
    border: none;
    border-radius: 7px;
    padding: 11px 22px;
    font-size: 14.5px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }
  .btn-primary:hover { background: var(--red-deep); color: #fff; text-decoration: none; }
  .btn-primary:disabled { opacity: 0.6; cursor: default; }

  .signup-msg {
    margin: 14px 0 0;
    padding: 12px 16px;
    max-width: 440px;
    border: 1px solid var(--red-edge);
    border-radius: 8px;
    color: var(--ink);
    font-size: var(--t-sm);
  }
  .signup-msg[hidden] { display: none; }

  .ask {
    margin: 12px 0 0;
    max-width: 440px;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--ink-3);
  }
  .secondary {
    margin: 12px 0 0;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }

  /* ── Dashboard Mockup Window ── */
  .win {
    border: 1px solid #2A3140;
    border-radius: 12px;
    overflow: hidden;
    background: #0E1116;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.8);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 14px;
    background: #12161D;
    border-bottom: 1px solid #2A3140;
  }
  .win-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: #2A3140;
    box-shadow: 14px 0 0 #2A3140, 28px 0 0 #2A3140;
    margin-right: 28px;
  }
  .win-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: #8B95A4;
  }

  .win-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid #2A3140;
    background:
      radial-gradient(ellipse 60% 140% at 22% 50%, rgba(74, 139, 245, 0.16) 0%, transparent 70%),
      linear-gradient(135deg, #0E1116 0%, #161B23 100%);
  }
  .win-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    color: #4A8BF5;
  }
  .win-brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: #E6EAF2;
  }
  .win-path {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8B95A4;
  }

  .win-body { padding: 16px; }
  .win-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8B95A4;
    margin-bottom: 12px;
  }
  .win-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  .pk {
    border: 1px solid #2A3140;
    border-radius: 10px;
    overflow: hidden;
    background: #1E242D;
  }
  .pk-thumb {
    position: relative;
    height: 90px;
  }
  .pk.audio     .pk-thumb { background: linear-gradient(135deg, #3D1208 0%, #1E0804 50%, #0A0402 100%); }
  .pk.broadcast .pk-thumb { background: linear-gradient(135deg, #0D2240 0%, #071529 50%, #030A14 100%); }
  .pk-thumb::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
  }

  .pk-tick {
    position: absolute; top: 8px; right: 8px; z-index: 1;
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
    font-size: 10px;
    color: #4ADE80;
    background: rgba(74, 222, 128, 0.18);
    border: 1px solid rgba(74, 222, 128, 0.4);
  }

  .pk-meta { padding: 9px 11px 11px; }
  .pk-name {
    font-size: 12px;
    font-weight: 700;
    color: #E6EAF2;
    line-height: 1.25;
  }
  .pk-sub {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    color: #8B95A4;
  }

  /* ── Terms Band ── */
  .terms {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
  }
  .term {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 15px;
    border-left: 1px solid var(--line);
  }
  .term:first-child { border-left: none; }

  .term-icon {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    color: var(--ink-2);
  }
  .term-text { min-width: 0; }

  .term dt {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .term dd {
    margin: 3px 0 0;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .brandbar-nav { display: none; }
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'copy' 'shot' 'terms';
      row-gap: 40px;
    }
    .sub { max-width: none; }
    .win { max-width: 520px; margin: 0 auto; }
  }

  @media (max-width: 560px) {
    .brandbar { padding: 16px var(--pad-x); }
    .brand-img { width: 135px; }
    .headline { margin-top: 16px; }
    .signup { flex-direction: column; padding: 6px; }
    .signup input { width: 100%; }
    .btn-primary { width: 100%; text-align: center; }
    .terms { grid-template-columns: repeat(2, 1fr); }
    .term { flex-direction: column; align-items: flex-start; gap: 8px; }
    .term:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .term:nth-child(odd)    { border-left: none; }
  }
</style>

<script>
  const form = document.getElementById('signup') as HTMLFormElement | null;
  const msg  = document.getElementById('signup-msg') as HTMLParagraphElement | null;

  if (form && msg) {
    const endpoint = form.dataset.endpoint;

    const show = (text: string) => {
      msg.textContent = text;
      msg.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      if (!endpoint) {
        event.preventDefault();
        show('Signups aren’t open yet — watch the GitHub repo for release news.');
        return;
      }

      event.preventDefault();
      const button = form.querySelector('button');
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        show('You’re on the list. We’ll email you when the first build is out.');
      } catch {
        if (button) { button.disabled = false; button.textContent = 'Notify me'; }
        show('That didn’t go through. Try again, or open an issue on GitHub.');
      }
    });
  }
</script>
