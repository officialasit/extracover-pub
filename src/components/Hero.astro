---
import { links, showDownloadCta, launchWindow } from '../site.config';

// Tabler-style glyphs, inlined as literal markup rather than pulled from an
// icon package — same reasoning as the rest of this codebase: no runtime
// dependency and no request for three 15px shapes.
const sidebarIcons = {
  packs:    '<path d="M4 6h16M4 12h16M4 18h10"/>',
  create:   '<path d="M12 5v14M5 12h14"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2"/>',
};

// The window is a picture of the product, not a live screenshot — the packs
// below are illustrative.
const packs = [
  { thumb: '🏟️', name: 'Wankhede Night Boards', meta: 'Stadium · v1.2 · 48 MB', status: 'installed', label: 'Installed' },
  { thumb: '📺', name: 'IPL Broadcast HUD',      meta: 'Overlays · v2.0 · 12 MB', status: 'installed', label: 'Installed' },
  { thumb: '🎯', name: 'Pitch Decal Pack',       meta: 'Textures · v1.0 · 9 MB',  status: 'ready',     label: 'Ready' },
];
---

<section class="hero" id="top">
  <div class="hero-badge">
    <span class="hero-badge-dot" aria-hidden="true"></span>
    {launchWindow ?? 'Launching soon'} · Windows &amp; Steam
  </div>

  <h1>Mod Cricket 26<br />in <span>1 click</span></h1>

  <p class="hero-sub">
    Apply stadium textures, broadcast HUDs, and visual packs instantly.
    Automatic backups. No technical setup. Built for players, not power users.
  </p>

  <div class="hero-actions">
    {showDownloadCta
      ? <a href={links.releases} class="btn btn-primary">Download for Windows</a>
      : <a href="#cta" class="btn btn-primary">Get Early Access</a>}
    <a href={links.source} target="_blank" rel="noopener" class="btn btn-ghost"
       aria-label="View on GitHub (opens in new tab)">View on GitHub</a>
  </div>
  <p class="hero-note">
    {showDownloadCta
      ? 'Free & open source · Windows 10 and 11'
      : 'Free & open source · One notification on release'}
  </p>

  <div class="product-wrap">
    <div class="product-glow" aria-hidden="true"></div>
    <div class="product-window reveal reveal-lift">
      <div class="window-bar">
        <span class="window-dot" aria-hidden="true"></span>
        <span class="window-dot" aria-hidden="true"></span>
        <span class="window-dot" aria-hidden="true"></span>
        <span class="window-title">Extra Cover — Pack Browser</span>
      </div>
      <div class="window-body">
        <div class="sidebar" aria-hidden="true">
          <div class="sidebar-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={sidebarIcons.packs} />
            My Packs
          </div>
          <div class="sidebar-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={sidebarIcons.create} />
            Create Pack
          </div>
          <div class="sidebar-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" set:html={sidebarIcons.settings} />
            Settings
          </div>
        </div>

        <div class="main-panel">
          <div class="panel-header">
            <h2>Installed Packs</h2>
            <span class="panel-badge">2 active</span>
          </div>
          {packs.map((pack) => (
            <div class="pack-card">
              <div class="pack-thumb" aria-hidden="true">{pack.thumb}</div>
              <div class="pack-info">
                <div class="pack-name">{pack.name}</div>
                <div class="pack-meta">{pack.meta}</div>
              </div>
              <span class={`status ${pack.status}`}>{pack.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 132px var(--pad-x) 72px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 13px;
    color: var(--text-2);
    margin-bottom: 20px;
  }
  .hero-badge-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--accent-soft);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px var(--accent-soft); }
    50%      { box-shadow: 0 0 0 5px rgba(225, 29, 72, 0.08); }
  }

  .hero h1 {
    font-size: clamp(40px, 6vw, 60px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    max-width: 780px;
    margin: 0 auto 18px;
  }
  .hero h1 span { color: var(--accent); }

  .hero-sub {
    font-size: 17px;
    color: var(--text-2);
    max-width: 500px;
    margin: 0 auto 36px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 14px;
  }
  .hero-actions :global(.btn) {
    height: 44px;
    padding: 0 22px;
    font-size: 15px;
  }

  .hero-note {
    font-size: 13px;
    color: var(--text-3);
  }

  /* ── Product window ────────────────────────────────────────────────────── */

  .product-wrap {
    position: relative;
    margin: 56px auto 0;
    max-width: 900px;
  }

  .product-glow {
    position: absolute;
    inset: -40px -20px -20px;
    background: radial-gradient(ellipse 70% 50% at 50% 30%, var(--accent-glow), transparent 70%);
    pointer-events: none;
    opacity: 0.55;
    z-index: 0;
  }

  .product-window {
    position: relative;
    z-index: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 32px 64px -16px rgba(0, 0, 0, 0.55);
    text-align: left;
    transform-origin: center top;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }
  .window-dot { width: 10px; height: 10px; border-radius: 50%; background: #333; }
  .window-dot:nth-child(1) { background: #ff5f57; }
  .window-dot:nth-child(2) { background: #febc2e; }
  .window-dot:nth-child(3) { background: #28c840; }
  .window-title {
    margin-left: 12px;
    font-size: 12px;
    color: var(--text-3);
    font-family: var(--mono);
  }

  .window-body {
    display: grid;
    grid-template-columns: 210px 1fr;
    min-height: 320px;
  }

  .sidebar {
    background: var(--bg-elevated);
    border-right: 1px solid var(--border);
    padding: 14px 10px;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--text-3);
    margin-bottom: 2px;
  }
  .sidebar-item.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }
  .sidebar-item svg { width: 15px; height: 15px; opacity: 0.75; flex-shrink: 0; }

  .main-panel { padding: 18px; }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .panel-header h2 { font-size: 13.5px; font-weight: 600; }
  .panel-badge { font-size: 12px; color: var(--text-3); font-family: var(--mono); }

  .pack-card {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 12px 13px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 8px;
    transition: border-color 0.25s ease, background 0.25s ease,
                transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pack-card:hover {
    border-color: var(--accent-edge);
    background: var(--surface-3);
    transform: translateX(3px);
    box-shadow: -3px 0 0 var(--accent);
  }

  .pack-thumb {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: linear-gradient(135deg, #27272a, #18181b);
    display: grid;
    place-items: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  .pack-info { flex: 1; min-width: 0; }
  .pack-name { font-size: 13px; font-weight: 500; margin-bottom: 1px; }
  .pack-meta { font-size: 11.5px; color: var(--text-3); }

  .status {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 6px;
    font-family: var(--mono);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }
  .status.installed { background: var(--green-soft); color: var(--green); }
  .status.installed::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--green);
    border-radius: 50%;
    animation: status-pulse 2s ease-in-out infinite;
  }
  .status.ready { background: rgba(255, 255, 255, 0.04); color: var(--text-3); }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  @media (max-width: 900px) {
    .window-body { grid-template-columns: 1fr; }
    .sidebar { display: none; }
  }

  @media (max-width: 600px) {
    .hero { padding: 112px 16px 56px; }
    .hero-actions { flex-direction: column; align-items: center; }
    .hero-actions :global(.btn) { width: 100%; max-width: 280px; }
    /* The meta line and the status chip cannot share a 320px row without the
       pack name truncating to nothing. */
    .pack-card { flex-wrap: wrap; }
  }
</style>
