---
import { Image } from 'astro:assets';
import banner from '../assets/white-banner.png';
import { subscribeEndpoint, showDownloadCta, links } from '../site.config';
---

<section class="hero">
  <div class="pill">
    <span class="pill-dot" aria-hidden="true"></span>
    Launching soon
  </div>

  {/*
    The source art is a 1983x793 PNG weighing 1.7 MB. Astro's sharp pipeline
    re-encodes it to WebP at the widths actually rendered, which takes it to a
    fraction of that — by far the largest saving available on this page.
    The 1520 entry covers 2x displays at the 760px layout width; `densities`
    cannot be combined with `widths`, since srcset can't mix `w` and `x`.
  */}
  <Image
    src={banner}
    alt="Extra Cover — modding software for Cricket 26"
    widths={[520, 760, 1140, 1520]}
    sizes="(max-width: 820px) 92vw, 760px"
    loading="eager"
    fetchpriority="high"
    class="banner"
  />

  <p class="tagline">IPL atmosphere for Cricket 26. One click. No modding skills needed.</p>

  {showDownloadCta ? (
    <a class="btn-primary download" href={links.releases}>Download for Windows</a>
  ) : (
    <form
      class="signup"
      id="signup"
      method="post"
      action={subscribeEndpoint ?? undefined}
      data-endpoint={subscribeEndpoint ?? ''}
    >
      <label class="sr-only" for="email">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="you@email.com"
        autocomplete="email"
      />
      <button type="submit" class="btn-primary">Notify me</button>
    </form>
  )}

  {/* Replaces the form on success, or explains itself if no endpoint is wired. */}
  <p class="signup-msg" id="signup-msg" role="status" aria-live="polite" hidden></p>

  <div class="fineprint">Free forever · Windows · Steam version of Cricket 26</div>
</section>

<style>
  .hero {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: 120px 24px 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--red-edge);
    color: var(--red-bright);
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
  }

  .banner {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .tagline {
    margin: 0;
    max-width: 520px;
    font-size: clamp(17px, 2.4vw, 21px);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .signup {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
    width: 100%;
    max-width: 460px;
  }
  .signup input {
    flex: 1 1 240px;
    min-width: 0;
    background: var(--input-bg);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 16px;   /* 16px avoids iOS zooming the page on focus */
    color: var(--ink);
    font-family: inherit;
    outline: none;
  }
  .signup input:focus { border-color: var(--red); }

  .btn-primary {
    flex: 0 0 auto;
    display: inline-block;
    background: var(--red);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 14px 26px;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.13s;
  }
  .btn-primary:hover { background: var(--red-deep); color: #fff; text-decoration: none; }
  .download { margin-top: 8px; }

  .signup-msg {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 8px 0 0;
    padding: 14px 22px;
    border: 1px solid var(--red-edge);
    border-radius: 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
  }
  .signup-msg[hidden] { display: none; }

  .fineprint { font-size: 13px; color: var(--ink-3); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .hero { padding-top: 72px; }
  }
</style>

<script>
  // Progressive enhancement: without JS the form is a plain POST to the
  // configured endpoint, which still works. With JS it submits in the
  // background so the page doesn't navigate away.
  const form = document.getElementById('signup') as HTMLFormElement | null;
  const msg  = document.getElementById('signup-msg') as HTMLParagraphElement | null;

  if (form && msg) {
    const endpoint = form.dataset.endpoint;

    const show = (text: string) => {
      msg.textContent = text;
      msg.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      // No endpoint configured: say so rather than pretending it worked.
      // Quietly discarding an address someone typed is the worse failure.
      if (!endpoint) {
        event.preventDefault();
        show('Signups aren’t open yet — follow the GitHub repo for release news.');
        return;
      }

      event.preventDefault();
      const button = form.querySelector('button');
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        show('✓ You’re on the list — we’ll email you at launch.');
      } catch {
        if (button) { button.disabled = false; button.textContent = 'Notify me'; }
        show('That didn’t go through. Try again, or open an issue on GitHub.');
      }
    });
  }
</script>
