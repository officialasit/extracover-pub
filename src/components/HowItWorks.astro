---
const steps = [
  { label: 'Auto Detection', detail: 'Locates your Steam installation of Cricket 26 automatically.' },
  { label: 'Select a Pack',    detail: 'Choose a stadium texture, decal, or broadcast HUD pack.' },
  { label: 'Play the Game',   detail: 'Launch Cricket 26 — modifications are live in 1 click.' },
];
---

<section class="how reveal" id="how-it-works">
  <div class="how-header">
    <div class="eyebrow">Workflow</div>
    <h2 class="h-display section-title">Three steps to 1-click modding</h2>
  </div>

  <ol class="strip">
    {steps.map((step, i) => (
      <li class="step">
        <span class="idx" aria-hidden="true">0{i + 1}</span>
        <span class="text">
          <h3 class="name">{step.label}</h3>
          <span class="detail">{step.detail}</span>
        </span>
      </li>
    ))}
  </ol>
</section>

<style>
  .how {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .how-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface-card);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    border-left: 1px solid var(--line-2);
  }
  .step:first-child { border-left: none; }

  .idx {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--red-edge);
    border-radius: 8px;
    background: var(--red-veil);
    color: var(--red-bright);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }

  .name {
    font-family: var(--font-display);
    font-size: var(--t-base);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
    margin: 0;
  }
  .detail {
    font-size: var(--t-sm);
    color: var(--ink-3);
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .strip { grid-template-columns: 1fr; }
    .step {
      border-left: none;
      border-top: 1px solid var(--line-2);
      padding: 18px 20px;
    }
    .step:first-child { border-top: none; }
  }
</style>
