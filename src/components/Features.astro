---
const features = [
  {
    tag: 'Apply',
    title: 'One-Click Apply & Restore',
    body: 'Mods install and uninstall with a single click. Your original files are always backed up automatically.',
  },
  {
    tag: 'Audio',
    title: 'IPL Atmosphere Pack',
    body: 'Authentic crowd noise, stadium chants, and ambient noise for a full match-day feel in-game.',
  },
  {
    tag: 'Setup',
    title: 'Auto Game Detection',
    body: 'Finds your Steam installation of Cricket 26 automatically. No folder browsing, no config editing.',
  },
  {
    tag: 'Content',
    title: 'Audio & Textures Combined',
    body: 'A single pack can carry both stadium crowd audio and boundary boards, installed together in one step.',
  },
  {
    tag: 'Library',
    title: 'Multi-Pack Support',
    body: 'Combine multiple packs seamlessly. Removing one pack leaves your remaining mods untouched.',
  },
  {
    tag: 'Safety',
    title: 'Zero Risk Overwriting',
    body: 'Original game files are copied before modification, restoring exact bytes when uninstalled.',
  },
];
---

<section class="section features" id="features">
  <div class="eyebrow">Features</div>
  <h2 class="h-display section-title">Designed for simplicity</h2>

  <div class="grid">
    {features.map((f) => (
      <article class="card">
        <div class="tag">{f.tag}</div>
        <h3 class="title">{f.title}</h3>
        <p class="body">{f.body}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 40px;
  }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    background: var(--surface-card);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    padding: 24px 24px 26px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--red-edge);
    transform: translateY(-2px);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red-bright);
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    margin: 0 0 10px;
    font-size: var(--t-md);
    color: var(--ink);
    line-height: 1.3;
  }

  .body {
    margin: 0;
    font-size: var(--t-base);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .grid { margin-top: 28px; }
  }
</style>
