---
// Tabler/Feather-style glyphs, inlined — see the note in Hero.astro.
const features = [
  {
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
    title: 'Install in one click',
    body: 'Apply any pack instantly. Every original file is backed up automatically so you can undo everything just as easily.',
  },
  {
    icon: '<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
    title: 'Create your own packs',
    body: 'Turn your textures and overlays into shareable .c26pack files. No external tools. No complicated workflows.',
  },
  {
    icon: '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="M17 2l-5 5-5-5"/>',
    title: 'Stadiums & broadcast HUDs',
    body: 'Replace perimeter boards, outfield art, pitch decals, and full scorebug overlays. Make the ground feel alive.',
  },
  {
    icon: '<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>',
    title: 'Audio & commentary',
    body: 'Crowd chants, ambience, and commentary support are already in development. Visuals are just the beginning.',
    tag: 'Coming soon',
  },
];
---

<section class="section" id="features">
  <div class="section-label">Why Extra Cover</div>
  <h2 class="section-title">Everything you need.<br />Nothing you don’t.</h2>
  <p class="section-desc">
    Built for people who want the game to look and feel right — without the usual modding headaches.
  </p>

  <div class="features-grid">
    {features.map((feature, i) => (
      <div class="feature reveal" style={`--reveal-delay:${(i % 2) * 70}ms`}>
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={feature.icon} />
        </div>
        <h3>
          {feature.title}
          {feature.tag && <span class="tag">{feature.tag}</span>}
        </h3>
        <p>{feature.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .feature {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 26px;
    transition: border-color 0.3s ease,
                translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s ease;
  }
  .feature:hover {
    border-color: rgba(225, 29, 72, 0.22);
    translate: 0 -4px;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.5),
                0 0 0 1px rgba(225, 29, 72, 0.08);
  }
  .feature:hover .feature-icon {
    background: rgba(225, 29, 72, 0.18);
    scale: 1.05;
  }

  .feature-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent-soft);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    color: var(--accent);
    transition: background 0.3s ease, scale 0.3s ease;
  }
  .feature-icon svg { width: 18px; height: 18px; }

  .feature h3 {
    font-size: 15.5px;
    font-weight: 600;
    margin-bottom: 7px;
    letter-spacing: -0.01em;
  }

  .feature p {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .tag {
    display: inline-block;
    margin-left: 7px;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--amber-soft);
    color: var(--amber);
    vertical-align: middle;
  }

  @media (max-width: 900px) {
    .features-grid { grid-template-columns: 1fr; }
  }
</style>
