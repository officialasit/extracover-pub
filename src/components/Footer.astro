---
import { contactUrl, contactLabel, links } from '../site.config';

const base = import.meta.env.BASE_URL;

interface Props {
  /** Section anchors only resolve on the landing page. */
  sections?: boolean;
}
const { sections = true } = Astro.props;
const to = (hash: string) => (sections ? hash : `${base}${hash}`);
---

<footer class="footer">
  <div class="footer-links">
    <a href={links.source} target="_blank" rel="noopener">GitHub</a>
    <a href={contactUrl}>{contactLabel}</a>
    <a href={`${base}guide/`}>Guide</a>
    <a href={to('#features')}>Features</a>
    <a href={to('#faq')}>FAQ</a>
  </div>

  <p class="footer-meta">
    Made with care by
    <a href="https://github.com/officialasit" target="_blank" rel="noopener"
       aria-label="Asit Joshi on GitHub (opens in new tab)">Asit Joshi</a>
    · Built by a fan, for fans
  </p>
  <p class="footer-meta quiet">Windows · Steam · Free — no payments, ever.</p>

  <p class="footer-disclaimer">
    Extra Cover is an unofficial fan project. Not affiliated with, endorsed by, or connected to
    Big Ant Studios, Cricket 26, or the Indian Premier League.
  </p>
</footer>

<style>
  .footer {
    padding: 40px var(--pad-x) 56px;
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-size: 13.5px;
    color: var(--text-3);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--text); text-decoration: none; }

  .footer-meta {
    font-size: 13px;
    color: var(--text-4);
    margin-bottom: 6px;
  }
  .footer-meta a { color: var(--text-3); }
  .footer-meta a:hover { color: var(--text); text-decoration: none; }

  .footer-meta.quiet {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }

  .footer-disclaimer {
    font-size: 12px;
    color: var(--text-4);
    max-width: 460px;
    margin: 14px auto 0;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 600px) {
    .footer { padding: 36px 16px 48px; }
    .footer-links { gap: 16px 20px; }
  }
</style>
