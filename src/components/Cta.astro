---
import { subscribeEndpoint, showDownloadCta, links } from '../site.config';
---

<section class="cta" id="cta">
  {showDownloadCta ? (
    <>
      <h2>Get Extra Cover</h2>
      <p>Free, open source, and installed in a couple of minutes.</p>
      <a class="btn btn-primary download" href={links.releases}>Download for Windows</a>
      <p class="cta-note">Free forever. No accounts, no payments.</p>
    </>
  ) : (
    <>
      <h2>Be first to try it</h2>
      <p>Join the list. We’ll email you once when Extra Cover launches — nothing else.</p>

      <form
        class="cta-form"
        id="cta-form"
        method="post"
        action={subscribeEndpoint ?? undefined}
        data-endpoint={subscribeEndpoint ?? ''}
      >
        <label class="sr-only" for="cta-email">Email address</label>
        <input id="cta-email" name="email" type="email" required
               placeholder="Enter your email" autocomplete="email" />
        <button type="submit">Notify me</button>
      </form>

      <p class="cta-note">Free forever. No spam.</p>
      <p class="form-msg" id="cta-msg" hidden aria-live="polite" role="status"></p>
    </>
  )}
</section>

<style>
  .cta {
    padding: 112px var(--pad-x);
    text-align: center;
    border-top: 1px solid var(--border);
    background: linear-gradient(to bottom, var(--bg), var(--bg-elevated));
  }

  .cta h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }

  .cta > p {
    font-size: 16px;
    color: var(--text-2);
    margin-bottom: 28px;
  }

  .cta-form {
    display: flex;
    max-width: 400px;
    margin: 0 auto 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 4px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .cta-form:focus-within {
    border-color: rgba(225, 29, 72, 0.4);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .cta-form input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 11px 14px;
    font-size: 14px;
    font-family: inherit;
    color: var(--text);
    outline: none;
  }

  .cta-form button {
    flex: 0 0 auto;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .cta-form button:hover  { background: var(--accent-hover); }
  .cta-form button:active { transform: scale(0.98); }

  .download { height: 44px; padding: 0 22px; font-size: 15px; margin-bottom: 12px; }

  .cta-note { font-size: 13px; color: var(--text-3); }

  .form-msg {
    margin: 12px auto 0;
    max-width: 400px;
    font-size: 14px;
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .cta { padding: 80px 16px; }
  }
</style>

<script>
  // With no PUBLIC_SUBSCRIBE_ENDPOINT configured at build time the form has no
  // `action`, so a real submit would POST to the current URL — which GitHub
  // Pages cannot handle — and the typed address would be lost with no feedback.
  // Saying signup isn't open beats faking a success message. When an endpoint
  // *is* configured, data-endpoint is non-empty and this listener steps aside.
  const form = document.getElementById('cta-form') as HTMLFormElement | null;
  const msg = document.getElementById('cta-msg');
  if (form && msg && !form.dataset.endpoint) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.hidden = false;
      msg.textContent = "Signup isn't open yet — check back after launch.";
    });
  }
</script>
